// =====================================================================
// SLiM 4.x — Genetic-entropy DFE study
// Baseline replication of Hancock & Cardinale (2024) ("H&C"), with
// added intrinsic-fitness tracking and an extinction safeguard.
//
// ---------------------------------------------------------------------
// THIS FILE IS THE SINGLE TEMPLATE USED FOR EVERY RUN IN THE MANUSCRIPT.
// There are no separate scripts for the variants. As written below, it
// is configured for the H&C baseline:
//
//     deleterious DFE : gamma, mean s = -0.5, shape = 0.5   (m2)
//     beneficial rate : 1:100  (g1 fractions: 0.99 del / 0.01 ben)
//     beneficial DFE  : exponential, mean = 0.001            (m3)
//     run length      : 50,000 generations
//
// Each variant reported in the Results was produced from THIS file by
// editing the parameter lines tagged "EDIT FOR VARIANT" below and then
// re-running. The model structure is otherwise identical across runs.
//
// ---------------------------------------------------------------------
// Differences from H&C (2024) — added output/handling only; the
// underlying model is NOT changed:
//
//   1. Logs intrinsic_fitness (genomic fitness, density-corrected)
//      separately from the density-scaled mean_fitness.
//
//   2. Extinction handling:
//        - emits a full simulation dump the FIRST time N drops below 5
//          (the near-extinction state, used for allele-frequency
//          spectra at collapse), and
//        - prints a notice and halts the run if N reaches 0.
// =====================================================================

// test of genetic entropy
initialize() {
	initializeSLiMModelType("nonWF");
	defineConstant("K", 1000);	// carrying capacity

	// set up mutation
	initializeMutationType("m1", 0.5, "f", 0.0);        // neutral
	m1.convertToSubstitution = T;
	initializeMutationType("m2", 0.5, "g", -0.5, 0.5);  // deleterious  -- EDIT FOR VARIANT: gamma mean s, shape
	m2.convertToSubstitution = F;
	initializeMutationType("m3", 0.5, "e", 0.001);      // beneficial   -- EDIT FOR VARIANT: exponential mean
	m3.convertToSubstitution = F;

	// fraction of each mutation type in the genomic element
	initializeGenomicElementType("g1", c(m1, m2, m3), c(0, 0.99, 0.01));  // -- EDIT FOR VARIANT: beneficial:deleterious ratio
	initializeGenomicElement(g1, 0, 5e6);  // genome size
	initializeMutationRate(1e-7);
	initializeRecombinationRate(1e-6);
}

// each individual reproduces once with someone else at random
reproduction() {
	subpop.addCrossed(individual, subpop.sampleIndividuals(1));
}

// create an initial population of 1000 individuals
1 early() {
	sim.addSubpop("p1", 1000);
	log = community.createLogFile("GE_run.txt", logInterval=100);
	log.addCycle();
	log.addCustomColumn("Population_size",   "p1.individualCount;");
	log.addCustomColumn("Deleterious_muts",  "sim.countOfMutationsOfType(m2);");
	log.addCustomColumn("Beneficial_muts",   "sim.countOfMutationsOfType(m3);");
	log.addCustomColumn("Mean_fitness",      "mean(p1.cachedFitness(NULL));");
	log.addCustomColumn("Intrinsic_fitness", "mean(p1.cachedFitness(NULL)) * p1.individualCount / K;");
}

// density-dependent selection
early() {
	p1.fitnessScaling = K / p1.individualCount;
}

// extinction safeguard: capture near-collapse state, then halt at zero
late() {
	// Hard extinction: population has died out -- report and stop.
	if (p1.individualCount == 0) {
		catn("Population went extinct at generation " + community.tick);
		sim.simulationFinished();
	}
	// Near extinction: the first time N drops below 5, dump full state once
	// (used for allele-frequency spectra near collapse).
	if (p1.individualCount < 5 & !exists("nearExtinctFlag")) {
		defineGlobal("nearExtinctFlag", T);
		catn("WARNING: Population near extinction at generation " + community.tick + " with " + p1.individualCount + " individuals");
		sim.outputFull();
	}
}

// end of run -- EDIT FOR VARIANT: run length (generations)
50000 late() { sim.outputFull(); }
